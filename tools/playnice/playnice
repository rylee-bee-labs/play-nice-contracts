#!/usr/bin/env python3
"""playnice launcher — stdlib-only, no installer by design.

Makes `./tools/playnice/playnice work "..."` work from a library checkout
(and `$PLAY_NICE_LIBRARY/tools/playnice/playnice ...` for consumers) without
changing how the tool is found: it resolves its own path and execs the real
playnice.py next to it. There is still nothing to install and nothing beyond
the standard library.
"""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))  # follow a ~/.local/bin symlink
target = os.path.join(here, "playnice.py")
os.execv(sys.executable, [sys.executable, target, *sys.argv[1:]])
