{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rylee-Bee/play-nice-contracts/schema/library.schema.json",
  "$comment": "$id is a stable contract identifier from before the 2026-10-09 org move; it is compared as a string, not fetched.",
  "title": "library/0",
  "description": "A keeper's shelves of layered books (contract: library). Served at GET /room/library by a room that lists `library` in its offers.",
  "type": "object",
  "required": ["contract", "generated_at", "keeper", "shelves", "books"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "library/0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "keeper": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "look": { "$ref": "#/$defs/look" }
      }
    },
    "shelves": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "blurb": { "type": "string", "maxLength": 300 },
          "look": { "$ref": "#/$defs/look" },
          "cover": { "$ref": "#/$defs/picture" },
          "books": {
            "type": "array",
            "maxItems": 200,
            "description": "Books shelved by reference (rule 13): another keeper's canonical book, shown in this shelf's look.",
            "items": { "type": "object", "required": ["ref"], "additionalProperties": false,
                       "properties": { "ref": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}:[a-z0-9][a-z0-9-]{0,63}$" } } }
          }
        }
      }
    },
    "books": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/book" }
    },
    "glossary": {
      "type": "object",
      "description": "Tap to learn (rule 11): lower-case term -> its plain meaning, the keeper's own name, and other spellings.",
      "maxProperties": 2000,
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 .'/+-]{0,59}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["plain"],
        "additionalProperties": false,
        "properties": {
          "plain": { "type": "string", "minLength": 1, "maxLength": 300 },
          "local": { "type": "string", "maxLength": 80 },
          "also": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
          "book": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}:[a-z0-9][a-z0-9-]{0,63}$", "description": "The canonical book for this idea, as keeper:book-id (rule 13)." },
          "teach": { "type": "string", "maxLength": 40, "description": "Teach while building: the idea's group (rule 14)." },
          "when": { "type": "string", "maxLength": 200, "description": "One sentence: the shape of what a person makes that embodies it (rule 14)." }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "look": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$", "description": "Display hint; an unknown look falls back to a plain shelf." },
    "picture": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$", "description": "A picture name served at /room/art/{name}.webp." },
    "book": {
      "type": "object",
      "required": ["id", "shelf", "title", "short", "pages"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "shelf": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "short": { "type": "string", "minLength": 1, "maxLength": 300, "description": "One sentence in plain words." },
        "order": { "type": "integer", "minimum": 0 },
        "cover": { "$ref": "#/$defs/picture" },
        "source": { "type": "string", "maxLength": 300, "description": "Where the full truth lives (a doc path or link)." },
        "link": { "type": "string", "pattern": "^/(?!/)[^\\s]*$", "maxLength": 300, "description": "Same-origin path on the keeper's site." },
        "updated_at": { "type": "string", "format": "date-time" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "prefixItems": [{ "properties": { "kind": { "const": "plain" } } }],
          "items": {
            "type": "object",
            "required": ["kind", "text"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["plain", "voice", "words", "technical"] },
              "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
              "voice": { "type": "string", "maxLength": 60, "description": "Who speaks a voice page." }
            }
          }
        }
      }
    }
  }
}
