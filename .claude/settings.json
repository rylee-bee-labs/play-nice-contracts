{
  "permissions": {
    "deny": [
      "Read(.venv/**)",
      "Read(__pycache__/**)",
      "Read(.pytest_cache/**)",
      "Read(**/data/content.db)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
